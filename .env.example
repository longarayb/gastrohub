# =====================================================================
# GastroHub — variáveis de ambiente (MODELO, sem valores reais)
#
# Gere o .env local com:   pnpm env:init
# O script substitui os marcadores por senhas aleatórias fortes,
# não imprime as senhas e não sobrescreve um .env existente sem
# confirmação. O .env NUNCA é versionado.
# =====================================================================

# Aplicação
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (container)
POSTGRES_PORT=5432
POSTGRES_PASSWORD=__gerado_por_env_init__
GASTROHUB_OWNER_PASSWORD=__gerado_por_env_init__
GASTROHUB_APP_PASSWORD=__gerado_por_env_init__

# Conexões: <senha> é substituído pelo env:init com a senha do papel da URL.
# Runtime da API (gastrohub_app, sem DDL, sujeito a RLS)
DATABASE_URL=postgres://gastrohub_app:<senha>@localhost:5432/gastrohub
# Migrations (gastrohub_owner)
DATABASE_MIGRATION_URL=postgres://gastrohub_owner:<senha>@localhost:5432/gastrohub
# Testes automatizados (banco obrigatoriamente com sufixo _test)
TEST_DATABASE_URL=postgres://gastrohub_app:<senha>@localhost:5432/gastrohub_test
TEST_DATABASE_MIGRATION_URL=postgres://gastrohub_owner:<senha>@localhost:5432/gastrohub_test
