{
  "name": "@gastrohub/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do GastroHub (NestJS + Fastify)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@gastrohub/contracts": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
